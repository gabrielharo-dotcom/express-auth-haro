<%- include('partials/head', { title: 'Registrarse', page: 'signUp' }) %>
<section class="form-card card-panel">
  <h1>Crear cuenta</h1>
  <p>El registro crea una cuenta con rol de usuario.</p>
  <div id="message" class="message" role="alert"></div>
  <form id="signUpForm">
    <div class="row">
      <div class="input-field col s12 m6"><input id="name" name="name" required><label for="name">Nombre</label></div>
      <div class="input-field col s12 m6"><input id="lastName" name="lastName" required><label for="lastName">Apellido</label></div>
      <div class="input-field col s12 m6"><input id="phoneNumber" name="phoneNumber" type="tel" required><label for="phoneNumber">Teléfono</label></div>
      <div class="input-field col s12 m6"><input id="birthdate" name="birthdate" type="date" required><label class="active" for="birthdate">Fecha de nacimiento</label></div>
      <div class="input-field col s12"><input id="email" name="email" type="email" required><label for="email">Correo electrónico</label></div>
      <div class="input-field col s12"><input id="password" name="password" type="password" required minlength="8"><label for="password">Contraseña</label><span class="helper-text">Mínimo 8 caracteres, una mayúscula, un número y uno de # $ % & * @</span></div>
    </div>
    <button class="btn indigo" type="submit">Registrarme</button>
  </form>
  <p>¿Ya tienes cuenta? <a href="/signIn">Inicia sesión</a></p>
</section>
<%- include('partials/foot') %>
