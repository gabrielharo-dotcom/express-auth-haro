PORT=3000
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_host>/auth_haro_db?retryWrites=true&w=majority
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10
# Optional: create the first administrator on startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ADMIN_LAST_NAME=Principal
ADMIN_PHONE_NUMBER=999999999
ADMIN_BIRTHDATE=1990-01-01
